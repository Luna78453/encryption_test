              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <enabled value="false"/>
              <text value="CheckBox"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="9fc01" class="javax.swing.JButton" binding="encryptButton">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <label value="Encrypt"/>
          <text value="Encrypt"/>
        </properties>
      </component>
      <grid id="ee5be" binding="introitusExitusPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">

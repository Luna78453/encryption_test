<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.luna.encryptor.forms.EncryptorGUI">
  <grid id="27dc6" binding="contentPane" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="804" height="400"/>
    </constraints>
    <properties/>
    <clientProperties>
      <html.disable class="java.lang.Boolean" value="true"/>
    </clientProperties>
    <border type="none" title="Encryptor"/>
    <children>
      <component id="2c92f" class="javax.swing.JComboBox" binding="algorithmSelector">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <grid id="f79ba" binding="miscellaneaPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
